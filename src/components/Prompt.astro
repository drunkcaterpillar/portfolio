---
// the prompt at the foot of every page: type to jump anywhere on the site
---

<div id="prompt" class="mt-7">
  <label for="prompt-input" class="sr-only">search the site</label>
  <p class="group flex min-h-11 items-center whitespace-pre">
    ~ $ <input id="prompt-input" type="text" placeholder="search" autocomplete="off" spellcheck="false" class="min-w-0 bg-transparent p-0 caret-transparent outline-none placeholder:text-neutral-400" /><span aria-hidden="true" class="text-red-600/60 group-focus-within:text-red-600">█</span>
  </p>
  <ul id="matches" hidden class="list-none p-0"></ul>
  <p id="nomatch" hidden class="text-neutral-500">no matches found</p>
</div>

<script>
  import { highlight, hits, inWord, matches, parts, words } from '../lib/search';

  type Item = { title: string; path: string; href: string; tags?: string[]; summary?: string; text?: string };

  const root = document.querySelector<HTMLElement>('#prompt')!;
  const input = root.querySelector('input')!;
  const list = root.querySelector<HTMLElement>('#matches')!;
  const empty = root.querySelector<HTMLElement>('#nomatch')!;

  // the index is fetched once, the first time the prompt gets focus
  let index: Promise<Item[]> | undefined;
  const load = () => (index ??= fetch('/search.json').then((r) => r.json() as Promise<Item[]>));
  input.addEventListener('focus', load, { once: true });

  // the input is exactly as wide as its text, so the block caret sits right after it
  const fit = () => {
    input.style.width = `${(input.value || input.placeholder).length}ch`;
  };
  fit();

  // an exact hit anywhere outranks a loose one anywhere. within each, where the query lands
  // decides: title, then path and tags, then summary, then body
  const rank = (q: string, ps: string[], it: Item) => {
    const fields: [string, number, number, boolean][] = [
      [it.title, 100, 30, false],
      [`${it.path} ${(it.tags ?? []).join(' ')}`, 80, 25, false],
      [it.summary ?? '', 60, 20, true],
      [it.text ?? '', 40, 10, true],
    ];
    const whole = new RegExp(`\\b${q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`);
    let score = 0;
    let snippet = '';
    for (const [f, exact, loose, quote] of fields) {
      const k = f.toLowerCase();
      // a whole word beats the same letters buried in a longer one
      const s = whole.test(k) ? exact : k.includes(q) ? exact - 5 : matches(ps, k) ? loose : 0;
      if (s > score) {
        score = s;
        snippet = quote ? excerpt(f, q, ps) : '';
      }
    }
    return { score, snippet };
  };

  const excerpt = (text: string, q: string, ps: string[]) => {
    const lower = text.toLowerCase();
    let at = lower.indexOf(q);
    if (at < 0) {
      const w = words(text).find((w) => inWord(ps[0], w));
      at = w ? lower.indexOf(w) : 0;
    }
    const start = Math.max(0, at - 40);
    const end = Math.min(text.length, at + 70);
    return (start > 0 ? '...' : '') + text.slice(start, end).trim() + (end < text.length ? '...' : '');
  };

  async function filter() {
    const q = input.value.trim().toLowerCase();
    const ps = parts(q);
    const items = q ? await load() : [];
    if (input.value.trim().toLowerCase() !== q) return; // a newer keystroke took over
    const ranked = items
      .map((it) => ({ it, ...rank(q, ps, it) }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 8);
    list.replaceChildren(
      ...ranked.map(({ it, snippet }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = it.href;
        a.textContent = it.path;
        li.append(a);
        if (snippet) {
          const s = document.createElement('span');
          s.className = 'ml-4 text-neutral-500';
          s.textContent = snippet;
          li.append(s);
        }
        highlight(li, hits(ps, li.textContent ?? ''));
        return li;
      }),
    );
    list.hidden = ranked.length === 0;
    empty.hidden = !q || ranked.length > 0;
  }
  input.addEventListener('input', () => {
    fit();
    filter();
  });

  // ctrl k always lands here. slash does too, unless the page has a grep of its own
  document.addEventListener('keydown', (e) => {
    const typing = e.target === input;
    const grep = document.querySelector('#grep-input');
    if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !grep && !(e.target instanceof HTMLInputElement))) {
      e.preventDefault();
      input.focus();
      input.scrollIntoView({ block: 'center' });
    }
    if (e.key === 'Escape' && typing) {
      input.value = '';
      fit();
      filter();
      input.blur();
    }
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') list.querySelector<HTMLAnchorElement>('li a')?.click();
  });

  root.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    e.preventDefault();
    const links = [...list.querySelectorAll<HTMLAnchorElement>('li a')];
    const i = links.indexOf(document.activeElement as HTMLAnchorElement);
    const next = e.key === 'ArrowDown' ? links[i + 1] : links[i - 1];
    (next ?? (e.key === 'ArrowUp' ? input : links[0]))?.focus();
  });
</script>
