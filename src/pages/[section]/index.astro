---
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import { byDate, groupOf, sections, shortDate } from '../../lib/site';

export const getStaticPaths = () => sections.map((section) => ({ params: { section }, props: { section } }));

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { section } = Astro.props;
const entries = (await getCollection(section, (e) => !e.data.draft)).sort(byDate);
const groups = [...new Set(entries.map((e) => groupOf(e.id)))].sort((a, b) => (a ?? '').localeCompare(b ?? ''));
---

<Base title={section}>
  <h1>{section}</h1>
  {entries.length === 0 && <p class="text-neutral-500">nothing here yet.</p>}
  {
    groups.map((g) => (
      <>
        {g && <h2 id={g} class="mt-10 text-neutral-500">{g}/</h2>}
        <ul class="space-y-5">
          {entries
            .filter((e) => groupOf(e.id) === g)
            .map((e) => (
              <li>
                <a href={`/${section}/${e.id}`}>{e.data.title}</a>
                <span class="text-neutral-500">
                  {' '}{shortDate(e.data.date)}
                  {e.data.tags.map((t) => (
                    <a href={`/tags/${t}`} class="ml-3 no-underline hover:underline">#{t}</a>
                  ))}
                </span>
                {'summary' in e.data && e.data.summary && <p class="text-neutral-600">{e.data.summary}</p>}
              </li>
            ))}
        </ul>
      </>
    ))
  }
</Base>
