---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import { entries, shortDate } from '../../lib/site';

export async function getStaticPaths() {
  const all = await entries();
  return all.map((entry) => ({ params: { section: entry.collection, slug: entry.id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content } = await render(entry);

const meta = [shortDate(entry.data.date)];
if (entry.collection === 'shelf') meta.unshift(entry.data.author);
if (entry.collection === 'art') meta.unshift(entry.data.medium ?? '');
if (entry.collection === 'shelf' && entry.data.rating) meta.push(`${entry.data.rating}/5`);

const links: [string, string | undefined][] =
  entry.collection === 'projects' ? [['code', entry.data.repo], ['live', entry.data.link]] : [];

const canonical = 'canonical' in entry.data ? entry.data.canonical : undefined;
if (canonical) links.push(['first published on substack', canonical]);
---

<Base title={entry.data.title} description={'summary' in entry.data ? entry.data.summary : undefined} canonical={canonical}>
  <article>
    <header class="mb-8 text-neutral-500">
      <h1 class="mb-0 text-neutral-900">{entry.data.title}</h1>
      <p>
        {meta.filter(Boolean).join(' / ')}
        {links.map(([label, href]) => href && <a href={href} rel="noopener noreferrer" class="ml-3">{label}</a>)}
      </p>
      {
        entry.data.tags.length > 0 && (
          <p>
            {entry.data.tags.map((t) => (
              <a href={`/tags/${t}`} class="mr-3 no-underline hover:underline">#{t}</a>
            ))}
          </p>
        )
      }
    </header>
    {entry.collection === 'art' && <Image src={entry.data.cover} alt={entry.data.alt} class="mb-8" />}
    <Content />
  </article>
</Base>
