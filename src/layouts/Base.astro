---
import '../styles/global.css';
import Grep from '../components/Grep.astro';
import Prompt from '../components/Prompt.astro';

// cmd is the shell command that "printed" the page: cat for one file, ls for a listing
type Props = { title: string; description?: string; canonical?: string; cmd?: 'cat' | 'ls' };

const { title, description, canonical, cmd = 'ls' } = Astro.props;
const crumbs = Astro.url.pathname.split('/').filter(Boolean);

// the right prompt, where zsh keeps the git branch: the places i am outside this site
const elsewhere = [
  ['github', 'https://github.com/drunkcaterpillar'],
  ['substack', 'https://stochasticcarrot.substack.com'],
  ['goodreads', 'https://www.goodreads.com/user/show/30853796-sanyukta'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body class="min-h-dvh bg-white font-mono text-base leading-[1.75] text-neutral-900">
    <!-- an 80 column terminal, padding outside the count -->
    <div class="mx-auto box-content max-w-[80ch] px-5 pt-12 pb-20">
      <header class="flex flex-wrap justify-between gap-x-8 text-neutral-500">
        <p class="wrap-break-word">
          ~ $ {crumbs.length === 0 ? <><a href="https://oldmanprogrammer.net/source.php?dir=projects/tree" rel="noopener noreferrer" title="the real tree, where steve baker keeps it">tree</a> -F sanyukta</> : <>{cmd} <a href="/">sanyukta</a>/{crumbs.map((c, i) => <>{i > 0 && '/'}{i < crumbs.length - 1 ? <a href={i === 0 ? `/${c}` : `/${crumbs[0]}#${c}`}>{c}</a> : <span aria-current="page" class="text-neutral-900">{cmd === 'cat' ? c + '.md' : c}</span>}</>)}</>}{crumbs.length > 0 && <Grep scope={cmd === 'cat' ? 'file' : 'dir'} />}
        </p>
        <nav aria-label="elsewhere" class="space-x-4">
          {elsewhere.map(([name, href]) => <a href={href} rel="noopener noreferrer">{name}</a>)}
        </nav>
      </header>
      <main class="mt-7"><slot /></main>
      <Prompt />
    </div>
  </body>
</html>
